# ThreatSentinel configuration. Copy to .env and edit.
# Every value here is optional; the defaults run a full keyless SOC agent.

# ---------------------------------------------------------------- Server
HOST=127.0.0.1
PORT=8000
# DEBUG=true: REST calls work without a token (local development only).
DEBUG=false
ENVIRONMENT=development

# ---------------------------------------------------------------- Security
# Required whenever DEBUG=false: 32+ random characters. The API refuses to
# start with a missing, short, or well-known default value. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------- Zero-API-key intel
# Local forensics, Shodan InternetDB, RDAP and the CISA KEV catalog. No keys.
ENABLE_KEYLESS_INTEL=true

# ---------------------------------------------------------------- LLM (optional)
# Leave LLM_PROVIDER unset for deterministic, offline analysis. Local models
# need no API key. Secrets are redacted before any prompt leaves the process.
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=2048
# LLM_REDACT_SECRETS=true
# LLM_MAX_TOOL_STEPS=5

# ---------------------------------------------------------------- Paid intel (optional)
# Each key adds a source; leaving them out costs nothing but coverage.
# VIRUSTOTAL_API_KEY=
# ABUSEIPDB_API_KEY=
# URLVOID_API_KEY=
# SHODAN_API_KEY=

# ---------------------------------------------------------------- Agent
CONFIDENCE_THRESHOLD=0.7
EMERGENCY_THRESHOLD=0.8
MAX_INVESTIGATION_TIME=300
MAX_CONCURRENT_INVESTIGATIONS=10
INVESTIGATION_TIMEOUT=600
TASK_QUEUE_WORKERS=2

# ---------------------------------------------------------------- Rate limiting
# Requests per client per window (seconds)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ---------------------------------------------------------------- CORS
# JSON list or comma-separated. "*" is rejected because credentials are allowed.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

# ---------------------------------------------------------------- Storage
DATA_DIR=data
REPORTS_DIR=reports
MEMORY_DIR=data/memory
LOGS_DIR=logs
AUTO_SAVE_REPORTS=true

# ---------------------------------------------------------------- Logging
LOG_LEVEL=INFO

# ---------------------------------------------------------------- Monitoring
HEALTH_CHECK_INTERVAL=60
METRICS_ENABLED=true

# ---------------------------------------------------------------- Integrations (optional)
# JSON with an "integrations" object keyed by type: palo_alto, fortinet,
# pfsense, splunk, qradar, azure_sentinel, slack, teams, email, servicenow,
# jira, pagerduty. Response actions only reach these after risk scoring and,
# when escalated, analyst approval.
# INTEGRATIONS_CONFIG='{"integrations": {"slack": {"webhook_url": "https://hooks.slack.com/services/..."}}}'
